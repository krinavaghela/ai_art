{
  "name": "cat-paint",
  "version": "1.0.0",
  "private": true,
  "description": "30 s pencil-to-watercolor timelapse of a cat and a sparrow (Remotion + GSAP + SVG)",
  "scripts": {
    "studio": "remotion studio",
    "still": "remotion still CatPaint out/still.png",
    "render:mov": "remotion render CatPaint out/cat-paint-alpha.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png --concurrency=3 --timeout=120000",
    "render:webm": "remotion ffmpeg -y -i out/cat-paint-alpha.mov -c:v libvpx-vp9 -pix_fmt yuva420p -b:v 0 -crf 28 -row-mt 1 -deadline good -cpu-used 4 -auto-alt-ref 0 -an out/cat-paint-alpha.webm",
    "render:mp4": "remotion render CatPaintOnPaper out/cat-paint-paper.mp4 --codec=h264 --crf=20 --image-format=jpeg --concurrency=3 --timeout=120000"
  },
  "dependencies": {
    "@remotion/cli": "4.0.528",
    "gsap": "3.13.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.528"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
